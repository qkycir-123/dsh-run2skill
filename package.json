{
  "name": "dsh-run2skill",
  "version": "0.2.0",
  "description": "Turn explicit DSH session experience into reviewable native Skills",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-skills",
    "local-first",
    "human-in-the-loop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qkycir-123/dsh-run2skill.git"
  },
  "bugs": {
    "url": "https://github.com/qkycir-123/dsh-run2skill/issues"
  },
  "homepage": "https://github.com/qkycir-123/dsh-run2skill#readme",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.en.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:publication": "node --test probes/publication-cas/probe.spec.mjs probes/install-lifecycle/web-args.spec.mjs",
    "evaluate": "vitest run tests/frozen-evaluation.spec.ts tests/learning-frozen-evaluation.spec.ts --reporter=verbose",
    "probe:crash": "pnpm run build && node probes/crash-matrix/probe.mjs .",
    "build": "tsdown",
    "pack:check": "pnpm run build && pnpm pack --pack-destination .probe-work/package",
    "verify:candidate": "pnpm run build && pnpm run evaluate && node probes/crash-matrix/probe.mjs . && node probes/candidate/verify.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests probes/candidate probes/support probes/install-lifecycle/release-upgrade-probe.mjs vitest.config.ts tsdown.config.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:publication"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "react": "^18.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.2.25",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.30.2",
    "oxlint": "1.76.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
